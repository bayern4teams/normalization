# Settings of the app machine. Copy to deploy/.env (never committed), fill in,
# then `docker compose --env-file .env up -d` in this folder. Change any line
# and run that command again: the app restarts with the new value (~30 s).
# Guide: docs/DEPLOY.md.

# --- required ---------------------------------------------------------------

# The release image to run, from your private registry. One of:
#   ghcr.io/bayern4teams/normalization/api:v1.0.0
#   <your GitLab registry>/bayern/normalization/api:v1.0.0
NORM_IMAGE=

# This machine's private network address. The API listens only there.
NORM_BIND_ADDR=

# Password of the app's own database (any long random string; see docs/DEPLOY.md).
NORM_DB_PASSWORD=

# Encrypts saved connection passwords. Moving from another machine: copy that
# machine's key, or its saved connections cannot be read. New install:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NORM_SECRET_KEY=

# The libpostal service (address parsing), for example http://<box address>:6901
NORM_LIBPOSTAL_URL=

# --- optional (the default is used when empty or absent) --------------------

# Port of the UI and API on NORM_BIND_ADDR (default 8080).
NORM_PORT=
# Memory limit of the API container (default 4g).
NORM_MEM_LIMIT=
# Loopback port of the app's database, for backups (default 5535).
NORM_DB_PORT=
# Host names the API answers to besides NORM_BIND_ADDR, comma-separated (ADR-022).
NORM_ALLOWED_HOSTS=
# Networks the app may connect to besides the private ranges, comma-separated CIDRs (ADR-022).
NORM_ALLOWED_NETWORKS=
# Any other NORM_* setting in the repository's .env.example (clone tuning,
# batch sizes) may be added here too; its path settings are fixed by compose.
