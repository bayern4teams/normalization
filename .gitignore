__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.uv/
uv.lock.tmp

.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
htmlcov/
.coverage
.coverage.*
coverage.xml

node_modules/
dist/
build/
ui/.vite/

data/dictionaries/**/*.local.json

# Runtime-generated custom-dictionary state (normdict.CustomDictionaryStore,
# M6, §59) — never seed data, never committed.
data/custom-dictionaries/
out/
*.parquet
!tests/**/*.parquet

# libpostal model data — large binaries fetched by
# services/libpostal/_data_cache/download_data.sh, never committed.
# See docs/adr/ADR-005-address-normalization.md for why this is
# pre-fetched on the host rather than downloaded during `docker build`.
services/libpostal/_data_cache/*.tar.gz
services/libpostal/_data_cache/*.log

ui/test-results/
ui/playwright-report/
ui/blob-report/

.env
.env.*
!.env.example

*.log

.DS_Store
Thumbs.db

# deep-research working files (not part of the engine)
research_notes/
reports/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Code-intelligence indexes, regenerated by .githooks/post-commit. Local
# caches, not artifacts: committing them would leave the tree dirty after
# every single commit, since the hook rebuilds them immediately after.
# Teammates get their own by running the same commands (see CLAUDE.md).
graphify-out/

# Vale downloads style packages here on `vale sync` — regenerable, so not
# committed; the vocabulary under config/ IS committed (it is the truth).
.vale/styles/*
!.vale/styles/config/

# Local scratch (graph refresh log)
.tmp/

# Downloaded public benchmark data (never committed; SOURCE.md files are local too)
data/benchmarks/

# Pinned local guard binaries (gitleaks, actionlint) — downloaded by
# scripts/install_tools.sh with checksum verification; CI uses the pinned
# GitHub Actions instead. Local convenience, never committed.
.tools/
