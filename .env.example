# Metadata store (profiles, runs, dictionaries, collisions, sign-offs)
# Port 5535 (not the default 5432/5433) to avoid colliding with other local
# dev stacks' Postgres containers — see compose.yaml comment.
NORM_PG_DSN=postgresql://normalization:normalization@localhost:5535/normalization

# Sidecar store (Parquet + DuckDB catalog)
NORM_SIDECAR_DUCKDB_PATH=./data/sidecar/catalog.duckdb
NORM_SIDECAR_PARQUET_ROOT=./data/sidecar/parquet

# libpostal sidecar service
NORM_LIBPOSTAL_URL=http://localhost:8081
NORM_LIBPOSTAL_MODEL_SHA256=

# Read-only source connectors (examples — never used for writes)
NORM_SOURCE_PG_DSN=postgresql://readonly_user:readonly_pass@localhost:5434/source_demo
NORM_SOURCE_MYSQL_DSN=mysql://readonly_user:readonly_pass@localhost:3307/source_demo
NORM_SOURCE_MONGO_URI=mongodb://readonly_user:readonly_pass@localhost:27018/source_demo
NORM_SOURCE_CLICKHOUSE_URL=http://readonly_user:readonly_pass@localhost:8124/source_demo

# API
NORM_API_HOST=0.0.0.0
NORM_API_PORT=8080

# PII visibility (default masked; enable only for authorized roles)
NORM_PII_VISIBILITY=masked

# M15 connection registry — required for the Connect step (M21) to work;
# encrypts saved connection credentials at rest in Postgres. Generate a
# real one with:
#   uv run python -c "from normapi.secrets import generate_secret_key; print(generate_secret_key())"
NORM_SECRET_KEY=

# M17's persistent DuckDB cache tier — deliberately left off (see M17's
# verification pack: a real bench found it a net loss at ~8M-distinct-
# value scale). Leave unset/":memory:" unless you've re-benchmarked for
# your own data.
NORM_CACHE_PATH=:memory:

# Optional legacy single-column source path (M10) — server-side JSON
# mapping source_id -> connection spec, largely superseded by M15/M21's
# Connect flow. Leave unset unless you specifically need it; see
# compose.yaml's `api` service for the matching bind-mount note.
NORM_SOURCES_CONFIG_PATH=
