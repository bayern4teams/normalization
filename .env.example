# Metadata store (profiles, runs, dictionaries, collisions, sign-offs)
# Port 5535 (not the default 5432/5433) to avoid colliding with other local
# dev stacks' Postgres containers — see compose.yaml comment.
NORM_PG_DSN=postgresql://normalization:normalization@localhost:5535/normalization

# Sidecar store (Parquet + DuckDB catalog)
NORM_SIDECAR_DUCKDB_PATH=./data/sidecar/catalog.duckdb
NORM_SIDECAR_PARQUET_ROOT=./data/sidecar/parquet

# Normalization cache (separate from the sidecar catalog above — this is
# §103's distinct-value cache, not the value-level output store). Leave
# unset for a fresh in-memory-only cache each run (e.g. local `uv run`);
# set to a real file for cross-restart/cross-run reuse in a deployment.
NORM_CACHE_PATH=./data/sidecar/cache.duckdb

# libpostal sidecar service
NORM_LIBPOSTAL_URL=http://localhost:8081
NORM_LIBPOSTAL_MODEL_SHA256=

# Read-only source connectors (examples — never used for writes)
NORM_SOURCE_PG_DSN=postgresql://readonly_user:readonly_pass@localhost:5434/source_demo
NORM_SOURCE_MYSQL_DSN=mysql://readonly_user:readonly_pass@localhost:3307/source_demo
NORM_SOURCE_MONGO_URI=mongodb://readonly_user:readonly_pass@localhost:27018/source_demo
NORM_SOURCE_CLICKHOUSE_URL=http://readonly_user:readonly_pass@localhost:8124/source_demo

# API
NORM_API_HOST=0.0.0.0
NORM_API_PORT=8080

# Max rows a single POST /runs execution accepts before rejecting with a
# 413 (default 40000 if unset — measured, see normapi/store.py's
# DEFAULT_MAX_RUN_ROWS comment: ~50-70KB peak memory per genuinely-distinct
# row for a representative semantic type). Raise only once you've measured
# your own deployment's real headroom the same way, together with
# compose.yaml's api.mem_limit (4g by default).
NORM_MAX_RUN_ROWS=40000

# PII visibility (default masked; enable only for authorized roles)
NORM_PII_VISIBILITY=masked

# DB-clone-and-normalize feature: encrypts saved connection passwords at
# rest (decision #12). A Fernet key (URL-safe base64, 32 bytes), as read by
# normapi/secrets.py. compose.yaml refuses to start without it. Generate your
# own and keep it only in .env (git-ignored):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NORM_SECRET_KEY=<paste the generated Fernet key here>

# Host address the API port is published on (compose.yaml). Required, no
# default: use this host's private LAN address, never 0.0.0.0. Services other
# than the API publish on 127.0.0.1 only.
NORM_BIND_ADDR=<this host's private LAN address>

# --- Dictionaries -----------------------------------------------------
# Where the shipped dictionaries live. compose.yaml sets this to
# /app/data/dictionaries, matching the Dockerfile's COPY destination; the
# relative default only resolves when the API is run from the repo root.
NORM_DICTIONARIES_DIR=data/dictionaries
NORM_CUSTOM_DICTIONARIES_DIR=data/custom-dictionaries

# --- API ---------------------------------------------------------------
# Comma-separated allowed origins for CORS. Empty (the default) allows
# none, which is correct for a same-host deployment.
NORM_CORS_ORIGINS=

# --- Clone-and-normalize: semantic type detection ----------------------
# Minimum confidence before an unconfigured column is normalized at all.
# Lower catches more columns and risks normalizing one that only LOOKS
# like a known type; an explicit field_config always overrides detection.
NORM_CLONE_AUTODETECT_MIN_CONFIDENCE=0.9
# Rows sampled per column to confirm a name-based guess against real
# values. Higher is more reliable and slower at job-creation time.
NORM_CLONE_AUTODETECT_SAMPLE_ROWS=200

# Normalization worker processes. Capped at os.cpu_count(). Each worker
# holds a full normalizer registry, so this multiplies resident memory —
# raise it against compose.yaml's api.mem_limit, not in isolation.
NORM_CLONE_WORKERS=3

# How long a RUNNING clone job may go without checkpointing before
# GET /clone-jobs/{id} reports it `stale: true`. A job whose process was
# killed (OOM, container restart) never marks itself FAILED, so this is
# what distinguishes "dead" from "slow". Advisory only — nothing rewrites
# the job's status, and restarting a stale job resumes it.
NORM_CLONE_HEARTBEAT_TIMEOUT_SECONDS=900

# Fraction of a column's non-empty values that normalization may empty
# before the job records a column-level row in its error report. Typed
# destination columns turn every value that will not cast into NULL, and a
# per-row finding for each one is invisible in aggregate: measured on a
# real source, typing one revenue column NULLed 34.5% of it and the clone
# looked exactly like a column that was merely sparse. Below this, a
# column losing values is ordinary messiness. To FAIL such a job rather
# than report it, set `max_new_null_rate` on the job itself.
NORM_CLONE_NULL_RATE_REPORT=0.05

# Fraction of a column's values that may come back INVALID — genuinely not
# of the type the column was mapped to — before the job reports that the
# column may be mapped to the WRONG semantic type. Deliberately high: half
# a column failing its own type is a mapping problem, a few percent is
# dirty data the per-row report already covers value by value. Measured on
# a real source, a column mapped to COUNTRY held Wikidata descriptions
# ("Country located primarily in North America") and came back 99.2%
# INVALID — one fact about the mapping, previously readable only by reading
# 3,478 per-row findings. AMBIGUOUS never counts: a POSTCODE column with no
# country is 100% AMBIGUOUS and perfectly well typed.
NORM_CLONE_TYPE_MISMATCH_REPORT=0.5

# Maximum entities held in the cross-table entity->country map (used only
# when a job sets `cross_table_entity_key`). Measured at ~180 bytes per
# entry, so the default is ~360MB worst case — size it against
# compose.yaml's api.mem_limit, not in isolation. Past the cap the map
# stops growing and the job reports how many entities it skipped; those
# rows simply get no inferred country.
NORM_CLONE_ENTITY_MAP_MAX=2000000

# How many of a column's distinct CHANGED outputs each chunk feeds back in
# to check that normalizing them again changes nothing (Source.txt §71,
# `normalize(normalize(x)) == normalize(x)`). A property test already
# searches for counterexamples, but only over one normalizer and only over
# generated strings; real data reaches every semantic type under the job's
# real country/locale with values no generator produces. Costs one extra
# normalize per value checked, and only values normalization actually
# CHANGED are candidates — an output equal to its input is a fixed point by
# inspection. Set to 0 to turn the check off.
NORM_CLONE_IDEMPOTENCY_SAMPLE=50

# OpenLineage collector (D3). Every clone job stores its START/COMPLETE/FAIL
# events in the metadata database (GET /clone-jobs/{id}/lineage); when this is
# an http(s) URL (e.g. Marquez's /api/v1/lineage) they are also POSTed there.
# Best effort: an unreachable collector never fails a job. Empty = do not forward.
NORM_OPENLINEAGE_URL=

# --- Row batching ------------------------------------------------------
# These four were one shared constant (2000), so tuning any of them moved
# the others. They default to the same number but trade off differently.
#
# Rows read from the source per batch. ALSO fixes the resume checkpoint
# granularity and the window the distinct-value planner dedups over:
# raising it improves dedup and costs memory and coarser resume.
NORM_SOURCE_READ_BATCH_ROWS=2000
# Rows per INSERT, which is also the TRANSACTION boundary — larger means
# fewer round trips but more work redone after a mid-chunk crash.
NORM_DESTINATION_INSERT_CHUNK_ROWS=2000
# Rows per write to the metadata store. Bounds peak memory only.
NORM_PERSISTENCE_WRITE_CHUNK_ROWS=2000
# Page size when reading execution rows back out.
NORM_PERSISTENCE_PAGE_ROWS=2000

# Extra Host-header names the API accepts besides localhost, 127.0.0.1
# and NORM_BIND_ADDR (comma-separated). Needed only when callers use a DNS name.
NORM_ALLOWED_HOSTS=

# Extra networks allowed as callers and as database targets, on top of loopback,
# RFC 1918 and fc00::/7 (comma-separated CIDR). Empty by default; add
# 100.64.0.0/10 here only if a VPN or CGNAT range is meant to be trusted.
NORM_ALLOWED_NETWORKS=
